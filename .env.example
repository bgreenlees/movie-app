# Template for .env.local — names only, never real values. This file is committed.
#
# Normal setup: don't fill this in by hand. Pull the Development values from Vercel
# (they point at the Neon *dev* branch, never production):
#   vercel env pull .env.local --environment=development --project movie-app --scope bobgreenlees-gmailcoms-projects --yes
#
# When you add a new variable to the code, add its name here and to Vercel
# (`vercel env add`) for every environment that needs it.

# Postgres connection string. Locally this must be the Neon dev branch (ep-sparkling-resonance-…).
DATABASE_URL=

# NextAuth: signs session cookies. Generate one with `npx auth secret`.
AUTH_SECRET=
# Production only. Leave unset locally — NextAuth infers the host (trustHost: true).
# NEXTAUTH_URL=

# DEV-ONLY sign-in for agents and local testing (lib/devLogin.ts). Set DEV_LOGIN=1 only in
# your own .env.local. WARNING: never add it to Vercel, in any environment. It is ignored whenever
# NODE_ENV=production or VERCEL_ENV is preview/production, and only accepts @example.test emails.
# While it's on, run `npm run dev -- -H 127.0.0.1` so other devices on your network can't use it.
# DEV_LOGIN=

# Google OAuth (Google Cloud console → Credentials). Add http://localhost:3000 as an authorised origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TMDB API (https://www.themoviedb.org/settings/api).
TMDB_API_KEY=
# Optional. Defaults to https://api.themoviedb.org/3.
# TMDB_API_BASE_URL=

# Resend, for the in-app feedback form.
RESEND_API_KEY=
