datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  streamingServices          Int[]     @default([]) @map("streaming_services")
  hasCompletedOnboarding     Boolean   @default(false) @map("has_completed_onboarding")
  watchlistEntries    WatchlistEntry[]
  tvWatchlistEntries  TVWatchlistEntry[]
  sentConnections     UserConnection[] @relation("ConnectionRequests")
  receivedConnections UserConnection[] @relation("ConnectionAddressees")
  decideSessionsStarted DecideSession[]
  decideVotes           DecideVote[]
  connectionInvites     ConnectionInvite[]

  @@map("users")
}

/// An email invite to someone who has no account yet. `email` is stored trimmed
/// and lowercased. On that person's first sign-in it becomes a PENDING
/// UserConnection from the inviter, and `acceptedAt` is set.
model ConnectionInvite {
  id         String    @id @default(cuid())
  inviterId  String    @map("inviter_id")
  email      String
  createdAt  DateTime  @default(now()) @map("created_at")
  sentAt     DateTime? @map("sent_at")
  acceptedAt DateTime? @map("accepted_at")

  inviter User @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@unique([inviterId, email])
  @@index([email])
  @@map("connection_invites")
}

model UserConnection {
  id          String           @id @default(cuid())
  requesterId String           @map("requester_id")
  addresseeId String           @map("addressee_id")
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")

  requester   User @relation("ConnectionRequests",  fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User @relation("ConnectionAddressees", fields: [addresseeId], references: [id], onDelete: Cascade)
  decideSessions DecideSession[]

  @@unique([requesterId, addresseeId])
  @@map("user_connections")
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  // Kept (not deleted) when the addressee declines, so the requester can't
  // simply re-send. Treated as "not connected" everywhere.
  DECLINED
}

model Movie {
  id            Int       @id
  title         String
  posterPath    String?   @map("poster_path")
  releaseDate   String?   @map("release_date")
  overview      String?
  genres        Json?
  lastFetched   DateTime  @default(now()) @map("last_fetched")

  watchlistEntries WatchlistEntry[]

  @@map("movies")
}

model WatchlistEntry {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  movieId     Int      @map("movie_id")
  status      WatchStatus  @default(WANT_TO_WATCH)
  addedAt     DateTime @default(now()) @map("added_at")
  watchedAt   DateTime? @map("watched_at")
  platform    String?
  watchType   String?   @map("watch_type")
  rating      Int?
  review      String?   @db.Text

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie       Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
  @@map("watchlist_entries")
}

enum WatchStatus {
  WANT_TO_WATCH
  WATCHED
  NOT_INTERESTED
}

model TVShow {
  id              Int       @id
  name            String
  posterPath      String?   @map("poster_path")
  firstAirDate    String?   @map("first_air_date")
  overview        String?
  genres          Json?
  lastFetched     DateTime  @default(now()) @map("last_fetched")

  watchlistEntries TVWatchlistEntry[]

  @@map("tv_shows")
}

model TVWatchlistEntry {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  tvShowId        Int           @map("tv_show_id")
  status          TVWatchStatus @default(WANT_TO_WATCH)
  rating          Int?
  review          String?       @db.Text
  platform        String?
  currentSeason   Int?          @map("current_season")
  currentEpisode  Int?          @map("current_episode")
  addedAt         DateTime      @default(now()) @map("added_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tvShow  TVShow @relation(fields: [tvShowId], references: [id], onDelete: Cascade)

  @@unique([userId, tvShowId])
  @@index([userId])
  @@map("tv_watchlist_entries")
}

enum TVWatchStatus {
  WANT_TO_WATCH
  WATCHING
  WATCHED
  NOT_INTERESTED
}

enum MediaKind {
  MOVIE
  TV
}

enum DecideStatus {
  OPEN      // voting in progress
  MATCHED   // a winner was found
  NO_MATCH  // current round ended with no match; can start the next round
  PICKED    // "Just pick for us" was used
  CANCELLED
}

model DecideSession {
  id           String       @id @default(cuid())
  connectionId String       @map("connection_id")
  createdById  String       @map("created_by_id")
  /// MoodSelection, validated with zod on write
  mood         Json
  status       DecideStatus @default(OPEN)
  round        Int          @default(1)
  winnerId     String?      @map("winner_id") // DecideCandidate.id
  createdAt    DateTime     @default(now()) @map("created_at")
  resolvedAt   DateTime?    @map("resolved_at")
  expiresAt    DateTime     @map("expires_at") // createdAt + 6 h

  connection UserConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdBy  User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  candidates DecideCandidate[]
  votes      DecideVote[]

  @@index([connectionId, status])
  @@index([createdById, createdAt])
  @@map("decide_sessions")
}

model DecideCandidate {
  id        String    @id @default(cuid())
  sessionId String    @map("session_id")
  mediaType MediaKind @map("media_type")
  tmdbId    Int       @map("tmdb_id")
  round     Int // 1-3; round 1 is the first 10
  position  Int // order within the round
  score     Float // pair score at creation, for tie-breaks and "pick for us"
  /// Snapshot so the vote screen needs no TMDB calls:
  /// { title, posterPath, date, runtime, providerIds, reason }
  snapshot  Json

  session DecideSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  votes   DecideVote[]

  @@unique([sessionId, mediaType, tmdbId])
  @@index([sessionId, round])
  @@map("decide_candidates")
}

model DecideVote {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  candidateId String   @map("candidate_id")
  userId      String   @map("user_id")
  vote        Int // 0 = no, 1 = yes, 2 = really want (checked in code: 0-2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  session   DecideSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  candidate DecideCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([candidateId, userId])
  @@index([sessionId, userId])
  @@map("decide_votes")
}
