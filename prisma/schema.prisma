datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  streamingServices          Int[]     @default([]) @map("streaming_services")
  hasCompletedOnboarding     Boolean   @default(false) @map("has_completed_onboarding")
  watchlistEntries    WatchlistEntry[]
  tvWatchlistEntries  TVWatchlistEntry[]
  sentConnections     UserConnection[] @relation("ConnectionRequests")
  receivedConnections UserConnection[] @relation("ConnectionAddressees")

  @@map("users")
}

model UserConnection {
  id          String           @id @default(cuid())
  requesterId String           @map("requester_id")
  addresseeId String           @map("addressee_id")
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")

  requester   User @relation("ConnectionRequests",  fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User @relation("ConnectionAddressees", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@map("user_connections")
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
}

model Movie {
  id            Int       @id
  title         String
  posterPath    String?   @map("poster_path")
  releaseDate   String?   @map("release_date")
  overview      String?
  genres        Json?
  lastFetched   DateTime  @default(now()) @map("last_fetched")

  watchlistEntries WatchlistEntry[]

  @@map("movies")
}

model WatchlistEntry {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  movieId     Int      @map("movie_id")
  status      WatchStatus  @default(WANT_TO_WATCH)
  addedAt     DateTime @default(now()) @map("added_at")
  watchedAt   DateTime? @map("watched_at")
  platform    String?
  watchType   String?   @map("watch_type")
  rating      Int?
  review      String?   @db.Text

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie       Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
  @@map("watchlist_entries")
}

enum WatchStatus {
  WANT_TO_WATCH
  WATCHED
  NOT_INTERESTED
}

model TVShow {
  id              Int       @id
  name            String
  posterPath      String?   @map("poster_path")
  firstAirDate    String?   @map("first_air_date")
  overview        String?
  genres          Json?
  lastFetched     DateTime  @default(now()) @map("last_fetched")

  watchlistEntries TVWatchlistEntry[]

  @@map("tv_shows")
}

model TVWatchlistEntry {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  tvShowId        Int           @map("tv_show_id")
  status          TVWatchStatus @default(WANT_TO_WATCH)
  rating          Int?
  review          String?       @db.Text
  platform        String?
  currentSeason   Int?          @map("current_season")
  currentEpisode  Int?          @map("current_episode")
  addedAt         DateTime      @default(now()) @map("added_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tvShow  TVShow @relation(fields: [tvShowId], references: [id], onDelete: Cascade)

  @@unique([userId, tvShowId])
  @@index([userId])
  @@map("tv_watchlist_entries")
}

enum TVWatchStatus {
  WANT_TO_WATCH
  WATCHING
  WATCHED
  NOT_INTERESTED
}
